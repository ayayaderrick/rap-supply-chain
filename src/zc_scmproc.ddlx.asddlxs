@Metadata.layer: #CORE
@UI.headerInfo.title.type: #STANDARD
@UI.headerInfo.title.value: 'ProcurementID'
@UI.headerInfo.description.type: #STANDARD
@UI.headerInfo.description.value: 'MaterialName'
annotate view ZC_SCMPROC with
{
  @UI.facet: [ 
    { id:              'ProcurementDetails',
      type:            #FIELDGROUP_REFERENCE,
      targetQualifier: 'ProcurementDetailsGroup',
      label:           'Order Details',
      position:        10 },
    { id:              'ExchangeRateInfo',
      type:            #FIELDGROUP_REFERENCE,
      targetQualifier: 'ExchangeRateInfoGroup',
      label:           'Exchange Rate & Totals',
      position:        20 }
   ]
   
 @UI.lineItem: [
//    { position: 5, type: #FOR_ACTION, dataAction: 'Approve',     label: 'Approve Order',  emphasized: true  },
//    { position: 8, type: #FOR_ACTION, dataAction: 'RefreshRate', label: 'Refresh Rate' },
    { position: 10, importance: #HIGH }
  ]
//  @UI.identification: [
//    { position: 5,  type: #FOR_ACTION, dataAction: 'Approve',     label: 'Approve Order',  emphasized: true },
//    { position: 8,  type: #FOR_ACTION, dataAction: 'RefreshRate', label: 'Refresh Rate' },
//  ]
  @UI.fieldGroup:     [ { position: 5, qualifier: 'ProcurementDetailsGroup' } ]
  @UI.selectionField: [ { position: 10 } ]
  ProcurementID;
  
  @UI.lineItem:       [ { position: 20, importance: #HIGH } ]
  @UI.fieldGroup:     [ { position: 10, qualifier: 'ProcurementDetailsGroup' } ]
  @UI.selectionField: [ { position: 20 } ]
  MaterialName;
  
  @UI.lineItem:       [ { position: 30, importance: #MEDIUM } ]
  @UI.fieldGroup:     [ { position: 20, qualifier: 'ProcurementDetailsGroup' } ]
  Supplier;
  
  @UI.lineItem:       [ { position: 40, importance: #HIGH } ]
  @UI.fieldGroup:     [ { position: 30, qualifier: 'ProcurementDetailsGroup' } ]
  Quantity;
  
  @UI.lineItem:       [ { position: 50, importance: #HIGH } ]
  @UI.fieldGroup:     [ { position: 40, qualifier: 'ProcurementDetailsGroup' } ]
  UnitPrice;
  
//   ── Exchange Rate & Totals facet ────────────────────────────────────────
  @UI.lineItem:       [ { position: 60, importance: #HIGH } ]
  @UI.fieldGroup:     [ { position: 10, qualifier: 'ExchangeRateInfoGroup' } ]
  ExchangeRate;
  
  @UI.lineItem:       [ { position: 70, importance: #HIGH } ]
  @UI.fieldGroup:     [ { position: 20, qualifier: 'ExchangeRateInfoGroup' } ]
  TotalInPreferredCcy;
  
  @UI.fieldGroup:     [ { position: 30, qualifier: 'ExchangeRateInfoGroup' } ]
  RateFetchTimestamp;
  
  @UI.fieldGroup:     [ { position: 40, qualifier: 'ExchangeRateInfoGroup' } ]
  @UI.multiLineText: true
  ApiMessage;
  

  @UI.lineItem: [ {  position: 80, importance: #HIGH } ]
  @UI.fieldGroup:     [ { position: 50, qualifier: 'ProcurementDetailsGroup' } ]
  @UI.textArrangement: #TEXT_ONLY
  OverallStatus;
  
  
}