managed implementation in class ZBP_R_SCMPROC unique;
strict ( 2 );
with draft;
extensible;
define behavior for ZR_SCMPROC alias Procurement
persistent table zscm_a_proc
extensible
draft table zscm_d_proc
etag master LocalLastChangedAt
lock master total etag LastChangedAt
authorization master ( global )
{
  field ( readonly )
  ProcurementUUID,
  CreatedBy,
  CreatedAt,
  LocalLastChangedBy,
  LocalLastChangedAt,
  LastChangedAt;

  field ( readonly ) ExchangeRate, TotalInPreferredCcy, RateFetchTimestamp, OverallStatus, ApiMessage, ProcurementId;

  field ( mandatory ) MaterialName, UnitPrice, Quantity, SourceCurrency, PreferredCurrency;

  field ( numbering : managed )
  ProcurementUUID;


  create;
  update;
  delete;

  draft action Activate optimized;
  draft action Discard;
  draft action (features: instance) Edit;
  draft action Resume;
  draft determine action Prepare { validation validateCurrencies; validation validateQuantityAndPrice; }

  determination setProcurementId on save { create; }
  determination determineExchangeRateTotal on modify
  { field UnitPrice; field Quantity;
    field SourceCurrency; field PreferredCurrency; }
  determination setInitialStatus on modify {create;}

  validation validateCurrencies on save { create; field SourceCurrency; field PreferredCurrency; }
  validation validateQuantityAndPrice on save { create; field Quantity; field UnitPrice; }

  action (features: instance) refreshRate result [1] $self;
  action (features: instance) approve result [1] $self;

  side effects
  {
    field UnitPrice affects field TotalInPreferredCcy, field ExchangeRate, field ApiMessage, field RateFetchTimestamp;
    field Quantity affects field TotalInPreferredCcy;
    field SourceCurrency affects field TotalInPreferredCcy, field ExchangeRate, field ApiMessage, field RateFetchTimestamp;
    field PreferredCurrency affects field TotalInPreferredCcy, field ExchangeRate, field ApiMessage, field RateFetchTimestamp;
  }

  mapping for zscm_a_proc corresponding extensible
    {
      ProcurementUUID     = PROCUREMENT_UUID;
      ProcurementID       = PROCUREMENT_ID;
      MaterialName        = MATERIAL_NAME;
      Supplier            = SUPPLIER;
      Quantity            = QUANTITY;
      UnitOfMeasure       = UNIT_OF_MEASURE;
      UnitPrice           = UNIT_PRICE;
      SourceCurrency      = SOURCE_CURRENCY;
      PreferredCurrency   = PREFERRED_CURRENCY;
      ExchangeRate        = EXCHANGE_RATE;
      TotalInPreferredCcy = TOTAL_IN_PREFERRED_CCY;
      RateFetchTimestamp  = RATE_FETCH_TIMESTAMP;
      ApiMessage          = API_MESSAGE;
      OverallStatus       = OVERALL_STATUS;
      CreatedBy           = CREATED_BY;
      CreatedAt           = CREATED_AT;
      LocalLastChangedBy  = LOCAL_LAST_CHANGED_BY;
      LocalLastChangedAt  = LOCAL_LAST_CHANGED_AT;
      LastChangedAt       = LAST_CHANGED_AT;
    }

}